node_modules/
# build/ holds derived artifacts (payload cache, shell packs, LOD tiles) - tens of GB, never committed.
# The probe scripts and parsers that live there are source: they are how every number in HANDOFF.md was
# produced, and an untracked probe is a measurement that cannot be repeated after a disk incident.
build/*
!build/q_*.js
!build/q-*.js
!build/*_parse*.cjs
!build/parse_*.cjs
!build/chk_probes.sh
!build/run_*.sh
!build/mk_*.mjs
!build/mk_*.cjs
!build/panel_layout.txt
!build/spec_*.json
!build/doc_*.md
!build/*.mjs
# The skin pack is derived (tools/fetch-skins.mjs pulls faces from Mojang) and stays out of git, but the
# DIRECTORY is tracked by a keep file: the image's `COPY build/skins/` must not fail on a machine that has
# not fetched skins, because the pack is optional and its absence is a normal answer.
!build/skins/
build/skins/*
!build/skins/.keep
.cache/
*.log
.DS_Store

logs/
# The save and the server root it came with: 3.6 GB of region files, mod jars, crash logs and
# a copy of the Mojang client jar. It is the viewer's input, not its source, and none of it is ours to
# push anywhere. Point --world at wherever the save lives on the server; the path is a flag, not a constant.
DarkRPG/

# deploy/ is what tools/deploy-pack.mjs stages for shipping; derived, and huge if you let it be.
deploy/
