node_modules/
# build/ holds derived artifacts (payload cache, shell packs, LOD tiles) - tens of GB, never committed.
# The probe scripts and parsers that live there are source: they are how every number in HANDOFF.md was
# produced, and an untracked probe is a measurement that cannot be repeated after a disk incident.
build/*
!build/q_*.js
!build/q-*.js
!build/*_parse*.cjs
!build/parse_*.cjs
!build/chk_probes.sh
!build/run_*.sh
!build/panel_layout.txt
!build/*.mjs
# What is deliberately NOT here any more: the splice machinery. `build/mk_*.cjs`, `build/spec_*.json` and
# `build/frag_*` were the scripts that edited web/js/*.js in place, because a hand-written whole-file patch
# script on a CRLF tree is how this project lost code once. Each was used once, worked, and went stale the
# next commit; they are not measurements and do not describe the product. 153 of them were most of build/'s
# tracked weight, so they are removed from the tree and from history, and they stay ignored.
# The skin pack is derived (tools/fetch-skins.mjs pulls faces from Mojang) and stays out of git, but the
# DIRECTORY is tracked by a keep file: the image's `COPY build/skins/` must not fail on a machine that has
# not fetched skins, because the pack is optional and its absence is a normal answer.
!build/skins/
build/skins/*
!build/skins/.keep

# The required packs get the same keep-file treatment, for a different reason. `COPY build/shells/` is a
# hard error when the directory is not in the build context, so a stack deployed from a CLONE of this
# repo could not even build - and what Docker reported was "failed to compute cache key ... /build/ledger:
# not found", which names no file and no fix. The directories are therefore tracked, their contents are
# not: the build gets as far as reporting which packs are missing, and worldd says so again at boot with
# the WD_* variable that points at the mount.
!build/assets/
build/assets/*
!build/assets/.keep
!build/shells/
build/shells/*
!build/shells/.keep
!build/lods/
build/lods/*
!build/lods/.keep
!build/ledger/
build/ledger/*
!build/ledger/.keep
.cache/
*.log
.DS_Store

logs/
# The save and the server root it came with: 3.6 GB of region files, mod jars, crash logs and
# a copy of the Mojang client jar. It is the viewer's input, not its source, and none of it is ours to
# push anywhere. Point --world at wherever the save lives on the server; the path is a flag, not a constant.
DarkRPG/

# deploy/ is what tools/deploy-pack.mjs stages for shipping; derived, and huge if you let it be.
deploy/

# The working notes. HANDOFF.md and PLAN.md are how every number in this project was produced and what was
# tried in which order - and they name real players and quote a private save's coordinates, so they stay on
# this machine and out of anything published. The probe scripts under build/ carry their own context, so a
# number can still be re-measured without the notes; tools/publish.mjs builds a publishable tree from the
# tracked files, which is why "tracked" is the thing that decides what leaves this box.
HANDOFF.md
PLAN.md
# the pre-underFar copy of the page, kept once to recover web/js/main.js (commit 3475dd5). Recovery net,
# not source: the live page is web/js/main.js.
main.js

# Dev-only deployment tooling. It names my box (an ssh target, a remote path, my upload endpoint) and it
# is a convenience, not part of the viewer: a clone deploys with the compose stack and the pack mounts
# documented in README. Kept out of git so "tracked" stays the thing that decides what leaves this box -
# and its test goes with it, because a test that imports a file a clone does not have is a red suite.
tools/world-push.mjs
tests/world-push.test.mjs

# Real player handles for this private save. Never publish this: the code, the probes and the docs
# use "player A".."player G" instead (tools/pseudonymise.mjs).
.private/

# second real save, used for multi-world testing (input, not source)
MCServerThanksgiving23/

# local multi-world test root (junctions to real saves; never tracked)
wroot/
build/cache-wroot/
build/census-thanksgiving.json
build/assets-thanksgiving/
Prominence_II_RPG_Server_Pack_v2.8.7/
